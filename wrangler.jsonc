{
  // Static site on Cloudflare Workers (static assets only, no Worker script).
  // Build first: python eval/build_site.py   then: npx wrangler deploy
  "name": "naija-eval",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
